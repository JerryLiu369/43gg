      "labelHalo": "#FFF8E7",
      "labelHaloWidth": 3.4,
      "hoverStroke": "#FFB300"
    },
    "routeSlot": {
      "strokeWidth": 1.1,
      "cornerRadius": 3,
      "slotHeight": 15,
      "slotGap": 4,
      "slotLengthNote": "Slot length is not fixed: each route's cars share the drawn track length (about 28-72 px on this board).",
      "hoverStroke": "#FFFFFF",
      "hoverStrokeWidth": 2.2,
      "selectionStroke": "#FFD600",
      "selectionStrokeWidth": 2.6,
      "dimmedOpacity": 0.35
    },
