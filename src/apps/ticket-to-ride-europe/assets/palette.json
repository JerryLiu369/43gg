  "boardTokens": {
    "_note": "Read by scripts/build_board_svg.py when it writes europe-map.svg. Slot geometry (slotHeight, slotGap, cornerRadius) must equal the constants in that script; verify_all.py checks this.",
    "cityNode": {
      "outerPinFill": "#FFFFFF",
      "outerPinStroke": "#1B1B1B",
      "outerPinWidth": 2,
      "innerCoreFill": "#1B1B1B",
